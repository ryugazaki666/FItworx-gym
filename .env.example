# Copy this file to .env and fill in the values below before running the server.
# `.env` is git-ignored and must never be committed.

# --- Server ---
PORT=3001

# Comma-separated frontend origins allowed to call the API.
# Leave empty for local development. In production, set this to your exact
# Pages/custom-domain URL(s); the server refuses to start without it.
APP_ORIGINS=

# Optional. Point this at a persistent disk on your API host.
# DATABASE_PATH=server/data/fitworx.sqlite

# Set these only while running `npm run bootstrap:admin` on a new database.
# Remove/unset them after the one-time bootstrap completes.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# A long, random secret used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Email (required for the "Working Email Function" requirement) ---
# Any real SMTP provider works: Gmail (with an App Password), Outlook,
# SendGrid, Mailgun, Brevo, your school/organization's SMTP relay, etc.
# Example values for Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-character-app-password   (NOT your normal Gmail password)
#   SMTP_FROM="FitWorx <youraddress@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FitWorx <no-reply@example.com>"

# --- AI-Integrated Natural Language Reporting ---
# Create a key at https://aistudio.google.com/apikey
# Without this key, every other feature still works — only the AI
# Reporting Assistant page will show a clear "not configured" message.
# Uses Google's Interactions API (via the @google/genai SDK). If your key gets a "model no
# longer available" error for the default below, check https://ai.google.dev/gemini-api/docs/models
# for the current recommended model name and set it here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
